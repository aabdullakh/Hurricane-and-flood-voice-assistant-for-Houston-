# Copy to .env and fill in. NEVER commit .env.
# (Comments are on their own lines on purpose: some tools treat trailing comments as part of the value.)

# --- security (required unless ALLOW_INSECURE_DEV=1) ---
# Make long random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_SHARED_SECRET=
PHONE_HASH_SALT=
# 1 = run locally without secrets. NEVER on a public server.
ALLOW_INSECURE_DEV=0

# --- deployment (docker compose) ---
# Your domain, e.g. yourproject.example. Its A record must point at your Vultr VM's IP.
DOMAIN=
POSTGRES_PASSWORD=

# --- data sources ---
# NWS requires an identifying User-Agent: (your-site, your-email)
NWS_USER_AGENT=(yourproject.example, you@email.com)
HARRIS_COUNTY_FIPS=48201
POLL_SECONDS=600
MAX_GAUGE_MILES=10
# Heuristic thresholds. We do not have official flood-stage values per gauge yet.
RISE_ELEVATED_FT_HR=0.5
RISE_HIGH_FT_HR=1.5
STALE_MINUTES=180

# --- Gemini: post-call triage. (The voice agent's own LLM is chosen in the ElevenLabs dashboard.) ---
GEMINI_API_KEY=
# Check Google AI Studio for current model names.
GEMINI_MODEL=gemini-2.5-flash

# --- Backboard (optional) ---
ENABLE_BACKBOARD=0
BACKBOARD_API_KEY=
