# Copy to .env and fill in. NEVER commit .env.
# (Comments are on their own lines on purpose: some tools treat trailing comments as part of the value.)

# --- security (required unless ALLOW_INSECURE_DEV=1) ---
# Make long random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_SHARED_SECRET=
PHONE_HASH_SALT=
# 1 = run locally without secrets. NEVER on a public server.
ALLOW_INSECURE_DEV=0
# 1 = serve /docs, /redoc, /openapi.json. Keep 0 on a public server (404).
ENABLE_DOCS=0
# 1 = enable /admin/* (live/replay switch for demos). Keep 0 on a public server (404).
ENABLE_ADMIN=0
# Bad API keys allowed from one IP within the window before it gets HTTP 429.
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW_SECONDS=300

# --- deployment (docker compose) ---
# Site names (and so the HTTPS certificates) are set in the Caddyfile's site address, not here.
# DNS: each name's A record must point at the server (45.76.57.234).
POSTGRES_PASSWORD=

# --- data sources ---
# NWS requires an identifying User-Agent: (your-site, your-email)
NWS_USER_AGENT=(thefloodfather.surf, you@email.com)
HARRIS_COUNTY_FIPS=48201
POLL_SECONDS=600
GAUGE_MAX_MILES=10
# Heuristic thresholds. We do not have official flood-stage values per gauge yet.
RISE_ELEVATED_FT_HR=0.5
RISE_HIGH_FT_HR=1.5
STALE_MINUTES=180

# --- Gemini: post-call triage. (The voice agent's own LLM is chosen in the ElevenLabs dashboard.) ---
GEMINI_API_KEY=
# Check Google AI Studio for current model names.
GEMINI_MODEL=gemini-2.5-flash

# --- Backboard (optional) ---
ENABLE_BACKBOARD=0
BACKBOARD_API_KEY=
